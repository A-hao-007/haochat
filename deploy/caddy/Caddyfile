{$SITE_DOMAIN} {
	encode zstd gzip
	root * /srv

		route {
			# /wx/* 是微信服务器回调(公众号接入验证/事件推送/OAuth回调)，必须反代到后端
			@api path /capi/* /wx/* /doc.html /v2/* /v3/* /swagger* /webjars/*
			reverse_proxy @api backend:8080 {
				header_up X-Forwarded-For {remote_host}
				header_up X-Real-IP {remote_host}
			}

			@websocket path /websocket*
			reverse_proxy @websocket backend:8090 {
				header_up X-Forwarded-For {remote_host}
				header_up X-Real-IP {remote_host}
			}

			# MinIO 对象存储：预签名上传(PUT)与下载(GET)都走主域名的 bucket 路径前缀，
			# 经此反代到 minio:9000（Caddy 默认透传 Host，预签名签名校验通过）。
			@oss path /haochat/*
			reverse_proxy @oss minio:9000

			# 带内容 hash 的静态资源（index-041c0ce2.js 等）：内容变则文件名变，可永久缓存
			@immutable path /assets/*
			header @immutable Cache-Control "public, max-age=31536000, immutable"
			# SPA 入口每次协商（ETag），保证发版即生效
			@entry path / /index.html
			header @entry Cache-Control "no-cache"

			try_files {path} /index.html
			# 优先返回构建期预压缩的 .br/.gz，运行期零压缩开销
			file_server {
				precompressed br gzip
			}
		}
}

{$MINIO_DOMAIN} {
	encode zstd gzip
	reverse_proxy minio:9000
}

{$MINIO_CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy minio:9001
}
