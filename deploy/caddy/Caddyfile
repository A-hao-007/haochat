{$SITE_DOMAIN} {
	encode zstd gzip
	root * /srv

	@api path /capi/* /doc.html /v2/* /v3/* /swagger* /webjars/*
	reverse_proxy @api backend:8080

	@websocket path /websocket*
	reverse_proxy @websocket backend:8090

	handle {
		try_files {path} /index.html
		file_server
	}
}

{$MINIO_DOMAIN} {
	encode zstd gzip
	reverse_proxy minio:9000
}

{$MINIO_CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy minio:9001
}
