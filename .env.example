# Public addresses.
# Domain mode example:
# SITE_DOMAIN=haochat-demo.duckdns.org
# SITE_ORIGIN=https://haochat-demo.duckdns.org
# MINIO_ENDPOINT=https://haochat-demo-s3.duckdns.org
# MINIO_CONSOLE_URL=https://haochat-demo-minio.duckdns.org
# MINIO_DOMAIN=haochat-demo-s3.duckdns.org
# MINIO_CONSOLE_DOMAIN=haochat-demo-minio.duckdns.org
#
# IP-only mode example:
# SITE_DOMAIN=http://47.96.43.107
# SITE_ORIGIN=http://47.96.43.107
# MINIO_ENDPOINT=http://47.96.43.107:9000
# MINIO_CONSOLE_URL=http://47.96.43.107:9001
# MINIO_DOMAIN=http://127.0.0.1:19000
# MINIO_CONSOLE_DOMAIN=http://127.0.0.1:19001
SITE_DOMAIN=haochat-demo.duckdns.org
SITE_ORIGIN=https://haochat-demo.duckdns.org
MINIO_ENDPOINT=https://haochat-demo-s3.duckdns.org
MINIO_CONSOLE_URL=https://haochat-demo-minio.duckdns.org
MINIO_DOMAIN=haochat-demo-s3.duckdns.org
MINIO_CONSOLE_DOMAIN=haochat-demo-minio.duckdns.org
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MySQL
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=haochat
MYSQL_USER=haochat
MYSQL_PASSWORD=change-haochat-password

# Redis
REDIS_PASSWORD=change-redis-password

# Application secrets
JWT_SECRET=change-this-to-a-long-random-secret

# MinIO
MINIO_ROOT_USER=haochat-minio
MINIO_ROOT_PASSWORD=change-minio-root-password
MINIO_BUCKET=haochat
MINIO_ACCESS_KEY=haochat-minio
MINIO_SECRET_KEY=change-minio-root-password

# Optional file safety scanning. Enable only when a ClamAV service is available.
FILE_VIRUS_SCAN_ENABLED=false
FILE_VIRUS_SCAN_HOST=clamav
FILE_VIRUS_SCAN_PORT=3310
FILE_VIRUS_SCAN_TIMEOUT_MS=5000

# WeChat placeholders. Replace only when enabling WeChat login or callbacks.
WX_MP_APP_ID=disabled-app
WX_MP_SECRET=disabled-secret
WX_MP_TOKEN=disabled-token
WX_MP_AES_KEY=disabled-aes-key

# AI assistant. Disabled by default for zero external API cost.
DEEPSEEK_ENABLED=false
DEEPSEEK_KEY=

# OpenAI-compatible AI providers. Leave primary key empty to use DEEPSEEK_KEY.
# To enable long-term memory: docker compose --profile ai-memory up -d --build
AI_MEMORY_ENABLED=false
AI_QUERY_REWRITE_ENABLED=true
AI_PRIMARY_BASE_URL=https://api.deepseek.com/v1
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=deepseek-chat
AI_FALLBACK_ENABLED=false
AI_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# DeepSeek chat endpoints do not provide OpenAI embeddings. Configure a compatible
# embedding endpoint separately when AI_MEMORY_ENABLED=true.
AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
NEO4J_PASSWORD=change-neo4j-password

# Java runtime tuning for a small VM.
JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m -XX:+UseSerialGC
