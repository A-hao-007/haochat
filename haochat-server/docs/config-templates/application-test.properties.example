##################OSS??##################
oss.enabled=true
oss.type=minio
oss.endpoint=http://ahao.space
oss.access-key=YOUR_OSS_ACCESS_KEY
oss.secret-key=YOUR_OSS_SECRET_KEY
oss.bucketName=haochat
rocketmq.name-server=127.0.0.1:9876
rocketmq.access-key=
rocketmq.secret-key=
##################gpt??##################
haochat.chatgpt.use=false
haochat.chatgpt.uid=10001
haochat.chatgpt.key=YOUR_OPENAI_KEY
haochat.chatgpt.proxyUrl=
haochat.chatglm2.use=false
haochat.chatglm2.url=http://v32134.cc
haochat.chatglm2.uid=10002
##################DeepSeek配置##################
haochat.deepseek.use=true
haochat.deepseek.uid=10001
haochat.deepseek.key=YOUR_DEEPSEEK_KEY
haochat.deepseek.url=https://api.deepseek.com/v1/chat/completions
haochat.deepseek.model=deepseek-chat
haochat.deepseek.timeout=60
haochat.deepseek.max-tokens=2048
haochat.deepseek.limit=30
